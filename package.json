{
  "name": "max4live-ts-tools",
  "version": "0.2.0",
  "description": "TypeScript tools for working with Max patcher files",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "bin": {
    "maxpat": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgyllos/max4live-ts-tools.git"
  },
  "bugs": {
    "url": "https://github.com/alexgyllos/max4live-ts-tools/issues"
  },
  "homepage": "https://github.com/alexgyllos/max4live-ts-tools#readme",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepack": "npm run build",
    "pack:check": "node scripts/pack-check.mjs",
    "examples": "tsc -p examples/tsconfig.json && node .examples/examples/create.js && node .examples/examples/advanced.js && node .examples/examples/devices.js && node .examples/examples/parameters.js && node .examples/examples/dial-appearances.js",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run examples && npm run pack:check && npm run example:live-tempo",
    "example:live-tempo": "npm run build && tsc -p examples/live-tempo/tsconfig.json && node examples/live-tempo/build.mjs"
  },
  "dependencies": {
    "@tsln/amxd": "0.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tsln/live-object": "0.4.1",
    "@tsln/lom-types": "0.1.0",
    "@tsln/max-types": "0.2.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "oxfmt": "0.73.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
