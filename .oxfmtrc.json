{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "package-lock.json",
    "**/*.maxpat",
    ".examples/**",
    "examples/generated/**",
    "**/*.amxd"
  ]
}
