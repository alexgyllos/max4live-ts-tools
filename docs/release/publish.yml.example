# INACTIVE TEMPLATE. Owner must approve rights, visibility, account setup and activation.
name: Stage approved package
on:
  workflow_dispatch:
    inputs:
      approved_sha:
        description: Exact owner-approved main commit
        required: true
permissions:
  contents: read
jobs:
  stage:
    if: github.ref == 'refs/heads/main' && github.event.repository.private == false
    environment: npm-release
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09
      - name: Verify approved commit
        env:
          APPROVED_SHA: ${{ inputs.approved_sha }}
        run: test "$(git rev-parse HEAD)" = "$APPROVED_SHA"
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: 24
      - name: Install staged-publishing CLI
        run: npm install --global npm@11.19.1
      - run: npm ci
      - run: npm run release:check
      - name: Verify approved distribution metadata
        run: node --input-type=module -e 'import fs from "node:fs"; const p=JSON.parse(fs.readFileSync("package.json")); if(p.private || p.license!=="MIT" || p.version!=="0.1.0" || !fs.existsSync("LICENSE") || !fs.readFileSync("LICENSE","utf8").includes("MIT License")) process.exit(1);'
      # Configure this trusted publisher with stage-only permission. The owner
      # must separately approve the returned stage ID using npm and 2FA.
      # Staging a new package creates a public placeholder; dispatch needs approval.
      - name: Submit via registered stage-only npm trusted publisher
        run: npm stage publish --access public --provenance
